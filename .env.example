# Contact form (optional)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Local Docker MySQL (docker compose up -d) ---
# DATABASE_URL=mysql://tiecodes:tiecodes_dev_password@127.0.0.1:3307/tiecodes

# --- Production / docker-compose.prod.yml ---
MYSQL_DATABASE=tiecodes
MYSQL_USER=tiecodes
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
APP_PORT=3000
DATABASE_URL=mysql://tiecodes:change-me-db-password@127.0.0.1:3306/tiecodes

# Auth (required)
AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-strong-password-12-plus-chars

# Uploads: local (single VPS volume) or azure
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=5242880
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=portfolio
